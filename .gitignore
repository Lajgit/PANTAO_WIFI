/PanTao_2/MDK-ARM/*.uvguix.*
/PanTao_2/MDK-ARM/startup_*.lst
/PanTao_2/MDK-ARM/*_verify.uvprojx
/PanTao_2/MDK-ARM/.vscode/*.log
/PanTao_2/MDK-ARM/.vscode/*.log.lock
/PanTao_Ctrl/MDK-ARM/*.uvguix
/PanTao_Ctrl/MDK-ARM/*.uvguix.*
/PanTao_Ctrl/MDK-ARM/startup_*.lst
